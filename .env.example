# Salin file ini dengan nama .env lalu isi confignya. File .env JANGAN dicommit.

# MongoDB - Masukkan URL MongoDB di sini
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/booking_lapangan?retryWrites=true&w=majority"

# Auth.js - Jalankan command: npx auth secret
AUTH_SECRET=""

# Cloudflare R2 - Masukkan konfigurasi R2 di sini
R2_BUCKET=""
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL=""